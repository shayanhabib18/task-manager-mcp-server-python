{
  "manifest_version": "0.1",
  "name": "shayan.task-manager-mcp",
  "display_name": "Task Manager MCP",
  "version": "1.0.0",
  "description": "A simple task manager MCP server.",
  "author": {
    "name": "Shayan"
  },
  "server": {
    "type": "python",
    "entry_point": "server.py",
    "mcp_config": {
      "command": "${__dirname}/.venv/bin/python3",
      "args": [
        "${__dirname}/server.py"
      ]
    }
  }
}